# Database
DATABASE_URL=postgresql+asyncpg://collie:collie_secret@localhost:5432/collie_db

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Collie App Integration
COLLIE_APP_BASE_URL=https://api.collieapp.com
COLLIE_APP_CLIENT_ID=
COLLIE_APP_CLIENT_SECRET=
